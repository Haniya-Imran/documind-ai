# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set in Project → Settings → Environment Variables.

# Neon Postgres (added automatically when Neon is connected through the Vercel Marketplace)
DATABASE_URL=

# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Vercel Blob (added automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Protects /api/admin/seed and /api/admin/eval (at least 24 characters)
ADMIN_TOKEN=

# Public site settings
NEXT_PUBLIC_SITE_URL=https://documind-ai.vercel.app
NEXT_PUBLIC_GITHUB_REPO_URL=
NEXT_PUBLIC_GITHUB_REPO_NAME=
